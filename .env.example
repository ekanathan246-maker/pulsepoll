# Local Docker Compose already supplies working development values.
# Copy this file only when running services outside Compose.
ENV=development
PORT=8080
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGO_DB=pulsepoll
REDIS_ADDR=localhost:6379
# Use REDIS_URL=rediss://... for TLS cloud Redis. It takes precedence.
REDIS_URL=
FRONTEND_ORIGINS=http://localhost:5173,http://localhost
PUBLIC_URL=http://localhost
